<Project Sdk="Microsoft.NET.Sdk">
  <!-- KeepLid tray application (WPF windows + WinForms NotifyIcon). Packaged as MSIX by ..\KeepLid.Package. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 TFM gives access to WinRT APIs (StartupTask, Store license) through the C#/WinRT projection. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KeepLid</AssemblyName>
    <RootNamespace>KeepLid.App</RootNamespace>
    <StartupObject>KeepLid.App.Program</StartupObject>
    <ApplicationIcon>Assets\KeepLid.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <!-- The Store has no .NET 8 desktop runtime dependency: ship the runtime inside the package. -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WFAC010: the WinForms analyzer wants DPI awareness set from code, but this is a WPF app (NotifyIcon only):
         the app.manifest PerMonitorV2 declaration is the right place for WPF. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>1.0.0</Version>
    <Product>KeepLid</Product>
    <Company>KeepLid</Company>
    <Copyright>© 2026 KeepLid</Copyright>
    <!-- Keeps the working set small (tray app idling for hours). -->
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- App.xaml is a plain resource dictionary page: Program.Main decides between the UI and the watchdog. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Tray\*.ico" LogicalName="Tray.%(Filename).ico" />
    <EmbeddedResource Include="Assets\KeepLid.ico" LogicalName="KeepLid.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KeepLid.Core\KeepLid.Core.csproj" />
  </ItemGroup>
</Project>
