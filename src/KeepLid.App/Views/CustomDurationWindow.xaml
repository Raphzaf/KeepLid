<Window x:Class="KeepLid.App.Views.CustomDurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KeepLid.Core.Resources;assembly=KeepLid.Core"
        Style="{StaticResource KeepLidWindow}"
        Title="{x:Static res:Strings.Custom_Title}"
        Width="360">
    <StackPanel Margin="20,16">
        <TextBlock Text="{x:Static res:Strings.Custom_Label}" />
        <TextBox x:Name="Minutes" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.Custom_Start}" IsDefault="True" Click="OnStart" />
            <Button Content="{x:Static res:Strings.Process_Cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
