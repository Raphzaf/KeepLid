<Window x:Class="KeepLid.App.Views.LidGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KeepLid.Core.Resources;assembly=KeepLid.Core"
        Style="{StaticResource KeepLidWindow}"
        WindowStartupLocation="CenterScreen"
        Title="{x:Static res:Strings.Guide_Title}"
        Width="540">
    <!-- Shown when Windows refuses lid action writes without elevation (Phase 0 result, option a+). -->
    <StackPanel Margin="24,18,24,18">
        <TextBlock Text="{x:Static res:Strings.Guide_Intro}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static res:Strings.Guide_Step1}" TextWrapping="Wrap" Margin="0,12,0,4" />
        <TextBlock Text="{x:Static res:Strings.Guide_Step2}" TextWrapping="Wrap" Margin="0,4" />
        <TextBlock Text="{x:Static res:Strings.Guide_Step3}" TextWrapping="Wrap" Margin="0,4" />
        <TextBlock x:Name="Current" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.Settings_NoThermal}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static res:Strings.Guide_Open}" IsDefault="True" Click="OnOpen" />
            <Button Content="{x:Static res:Strings.Guide_Close}" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
