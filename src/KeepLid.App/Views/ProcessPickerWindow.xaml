<Window x:Class="KeepLid.App.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KeepLid.Core.Resources;assembly=KeepLid.Core"
        Style="{StaticResource KeepLidWindow}"
        Title="{x:Static res:Strings.Process_Title}"
        Width="460">
    <StackPanel Margin="20,16">
        <TextBlock Text="{x:Static res:Strings.Process_Hint}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.Process_Search}" Margin="0,12,0,2" />
        <TextBox x:Name="Search" TextChanged="OnSearchChanged" />
        <ListBox x:Name="List" Height="300" Margin="0,8,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,1">
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </TextBlock>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.Process_Start}" IsDefault="True" Click="OnStart" />
            <Button Content="{x:Static res:Strings.Process_Cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
