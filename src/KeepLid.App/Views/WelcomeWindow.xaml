<Window x:Class="KeepLid.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KeepLid.Core.Resources;assembly=KeepLid.Core"
        Style="{StaticResource KeepLidWindow}"
        WindowStartupLocation="CenterScreen"
        Title="{x:Static res:Strings.Welcome_Title}"
        Width="520">
    <!-- First launch: 3 steps (what it does, what the lid mode changes, safety tip). -->
    <StackPanel Margin="24,18,24,18">
        <TextBlock x:Name="StepCounter" Style="{StaticResource Hint}" />
        <TextBlock x:Name="StepTitle" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,12" />
        <TextBlock x:Name="StepBody" TextWrapping="Wrap" MinHeight="170" LineHeight="20" />
        <DockPanel Margin="0,18,0,0">
            <Button x:Name="BackButton" DockPanel.Dock="Left" Margin="0" Content="{x:Static res:Strings.Welcome_Back}" Click="OnBack" />
            <Button x:Name="NextButton" DockPanel.Dock="Right" IsDefault="True" Click="OnNext" HorizontalAlignment="Right" />
            <Border />
        </DockPanel>
    </StackPanel>
</Window>
