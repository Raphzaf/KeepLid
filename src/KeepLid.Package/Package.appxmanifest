<?xml version="1.0" encoding="utf-8"?>
<!--
  KeepLid MSIX manifest.
  * Used as-is by KeepLid.Package.wapproj (Visual Studio replaces $targetnametoken$ / $targetentrypoint$).
  * Used by build/package.ps1, which replaces the same tokens and the Identity values.
  Both put the app in a "KeepLid.App\" sub-folder of the package (Visual Studio layout), hence the explicit
  "KeepLid.App\KeepLid.exe" in the extensions (Visual Studio only resolves the tokens on <Application>).
  Identity Name / Publisher below are LOCAL TEST values: for the Store, use the values from
  Partner Center › Product identity (see store/01_identite/identite.md).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="KeepLid" Publisher="CN=KeepLid Test" Version="1.0.0.0" />

  <Properties>
    <DisplayName>KeepLid</DisplayName>
    <PublisherDisplayName>KeepLid</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="fr-FR" />
  </Resources>

  <Applications>
    <Application Id="KeepLid" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="KeepLid"
        Description="Keeps Windows awake while long tasks run, even with the lid closed, then restores everything."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" Square71x71Logo="Images\Square71x71Logo.png" Square310x310Logo="Images\Square310x310Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows": disabled by default, toggled from the settings window (StartupTask API). -->
        <uap5:Extension Category="windows.startupTask" Executable="KeepLid.App\KeepLid.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="KeepLidStartup" Enabled="false" DisplayName="KeepLid" />
        </uap5:Extension>
        <!-- "keeplid" can be typed in a terminal or Win+R to start the app (also used by the CI smoke test). -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="KeepLid.App\KeepLid.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="keeplid.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required for a Win32 desktop app (tray icon, power APIs). Justification: store/05_certification/justification_runFullTrust.md -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
